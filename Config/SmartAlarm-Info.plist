<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSAlarmKitUsageDescription</key>
	<string>SmartyAlarm schedules a system alarm so it can wake you reliably, even if the app is closed and your phone is silenced.</string>

	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>SmartyAlarm reads your morning events so it can wake you earlier when your first commitment starts sooner than usual, or is somewhere other than work.</string>

	<key>NSRemindersFullAccessUsageDescription</key>
	<string>SmartyAlarm checks for high-priority reminders due in the morning so it can add extra buffer on important days.</string>

	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>

	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>

	<!-- No encryption beyond what Apple's own frameworks use over HTTPS. Declaring this
	     avoids being asked the export-compliance question on every single upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>

	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.danielxiao.SmartAlarm.refresh</string>
		<string>com.danielxiao.SmartAlarm.nightly</string>
	</array>
</dict>
</plist>
